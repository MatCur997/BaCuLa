# Copia questo file in .env e personalizzalo. Il file .env NON va mai committato.

# Chiave condivisa con CHAT e VOICE (deve essere identica sulle 3 macchine).
# Generane una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambiami

# Indirizzo di ascolto: 0.0.0.0 = raggiungibile dalle altre macchine della LAN
HOST=0.0.0.0
PORT=8000

# LLM locale (Ollama gira sulla stessa macchina del backend)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_THINK=true
LLM_TEMPERATURE=0.2

# Durata di una conversazione inattiva prima che venga dimenticata
SESSION_TTL_MINUTES=60
