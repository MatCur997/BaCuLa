# Copia questo file in .env. Il file .env NON va mai committato.

# Indirizzo del backend nella LAN (IP della macchina BE)
BACKEND_URL=http://192.168.1.10:8000
# Deve coincidere con API_KEY del backend
API_KEY=cambiami

RESTAURANT_NAME=Osteria BaCuLa

# Il microfono nel browser funziona solo su localhost (o HTTPS): lasciare 127.0.0.1
HOST=127.0.0.1
PORT=8002

# Riconoscimento vocale: tiny | base | small | medium | large-v3
# auto = GPU NVIDIA se disponibile (librerie CUDA installate da setup.ps1 -Gpu), altrimenti CPU
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Sintesi vocale: auto (Piper se la voce è scaricata, altrimenti voce di Windows) | piper | windows
TTS_ENGINE=auto
PIPER_MODEL=models/it_IT-paola-medium.onnx
